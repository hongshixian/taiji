# 太极环境变量模板 — 复制为 .env 后修改

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# 数据库 (开发默认用 SQLite, 生产设置 PostgreSQL URL)
DATABASE_URL=sqlite:///../data/taiji.db

# Redis (Celery 后端)
REDIS_URL=redis://localhost:6379/0

# 认证模式：完成 IAM 迁移后使用 oidc；紧急回滚窗口可临时使用 legacy
AUTH_MODE=oidc

# 任务执行日志
TASK_LOG_ROOT=../app_logs

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=1800
JWT_REFRESH_TOKEN_EXPIRES=604800

# 初始管理员账号
# 仅在首次部署（数据库无 admin 时）生效
# 留空则启动时随机生成密码并打印到日志（推荐至少设置 ADMIN_PASSWORD）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@taiji.local
# ADMIN_PASSWORD=  # ← 取消注释并设置强密码（≥12 字符）

# Keycloak IAM（以下开发默认值仅供本地使用，生产必须全部替换）
KEYCLOAK_VERSION=26.7.0
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=8180
IAM_PUBLIC_URL=http://localhost:8180
IAM_INTERNAL_URL=http://localhost:8180
TAIJI_PUBLIC_URL=http://localhost:28080
TAIJI_PORT=28080
# HTTPS 在反向代理终止并转发 HTTP 时使用 xforwarded；TLS 透传时不要设置。
KC_PROXY_HEADERS=xforwarded
IAM_PROXY_HOST=localhost
IAM_PROXY_SCHEME=http
IAM_PROXY_PORT=8180
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=dev-only-change-me
TAIJI_OIDC_CLIENT_SECRET=taiji-web-dev-secret
TAIJI_RECONCILER_CLIENT_SECRET=taiji-reconciler-dev-secret
TAIJI_MIGRATOR_CLIENT_SECRET=taiji-migrator-dev-secret
# 仅迁移窗口临时启用，迁移完成后必须恢复 false 并重启 Keycloak
IAM_MIGRATION_ENABLED=false
IAM_IDENTITY_CACHE_SECONDS=300
IAM_RECONCILE_INTERVAL_SECONDS=300
IAM_EVENT_BATCH_SIZE=10
IAM_EVENT_ACK_WAIT_SECONDS=300
SESSION_IDLE_SECONDS=7200
SESSION_ABSOLUTE_SECONDS=86400
# 本地 HTTP 开发为 false；生产 HTTPS 必须设为 true
SESSION_COOKIE_SECURE=false

# 业务超级管理员一次性引导（与 Keycloak 基础设施管理员不同）
# 新环境会创建用户名 admin、生成随机临时密码并仅输出到 iam-bootstrap 容器日志。
IAM_BOOTSTRAP_ENABLED=true
IAM_REALM_RECONCILE_ENABLED=true
IAM_BOOTSTRAP_ADMIN_EMAIL=admin@taiji.local

# NATS JetStream（生产必须替换密码并使用持久化集群）
NATS_USER=taiji
NATS_PASSWORD=taiji_nats_dev
